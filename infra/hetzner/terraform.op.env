# 1Password secret references for the Hetzner / Cloudflare / Njalla Terraform. No secrets in
# this file, so it is committed. Usage, from the repository root:
#   op run --env-file infra/hetzner/terraform.op.env -- terraform -chdir=infra/hetzner plan
# or `make hz-plan`, `make hz-apply`. Each line names a field of an item in the vault `caselaw`.
HCLOUD_TOKEN=op://caselaw/hetzner-api/credential
CLOUDFLARE_API_TOKEN=op://caselaw/cloudflare-api/credential
TF_VAR_cloudflare_account_id=op://caselaw/cloudflare-api/account_id
TF_VAR_njalla_api_token=op://caselaw/njalla-api/credential
