# Runtime values of the caselaw server. Copy to infra/hetzner/runtime.secrets (ignored by git)
# or put the values into the 1Password item `caselaw-server`; `scripts/hz.sh secrets` writes
# them to /etc/caselaw/caselaw.env on the server (root:caselaw, mode 640). Terraform never reads
# this file. No `$` in any value (Docker Compose would expand it).

# Cloudflare R2 -> Manage R2 API tokens -> Object Read & Write on the bucket caselaw-runs.
# Create this key after the first `make hz-apply`, when the bucket exists. The loader reads
# s3://caselaw-runs/runs with it, the nightly backup writes dumps to it.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
R2_BUCKET=caselaw-runs

# Grafana Cloud -> Connections -> Add new connection -> Linux server -> Alloy install snippet.
# Leave empty to run without monitoring; `--profile monitoring` is added when they are set.
GCLOUD_HOSTED_METRICS_URL=
GCLOUD_HOSTED_METRICS_ID=
GCLOUD_HOSTED_LOGS_URL=
GCLOUD_HOSTED_LOGS_ID=
GCLOUD_RW_API_KEY=

# Optional: healthchecks.io check URL for the backup cron.
BACKUP_HEALTHCHECKS_URL=

# Which run the API serves.
CASELAW_RUN=regex-v0.4
