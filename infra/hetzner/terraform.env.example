# Credentials that Terraform needs to create the Hetzner server and the Cloudflare records.
# Copy to infra/hetzner/terraform.env (ignored by git). The Makefile sources it before
# `terraform`. One KEY=value per line, no quotes, no `$` in any value.

# Hetzner Cloud: project `caselaw` -> Security -> API tokens -> read & write
HCLOUD_TOKEN=

# Cloudflare: My Profile -> API Tokens -> Create Token, permissions
#   Zone / DNS / Edit on inat.io, and Account / Workers R2 Storage / Edit
CLOUDFLARE_API_TOKEN=

# Cloudflare: R2 overview page, right-hand column -> Account ID
CLOUDFLARE_ACCOUNT_ID=
