# Two hosts, both with automatic Let's Encrypt certificates. Caddy's metrics on :2020 (inside
# the Docker network only; the admin API stays on localhost) give the Grafana agent request
# counts, status codes and latency histograms per host, the role the AWS load balancer metrics had.
{
	metrics
}

:2020 {
	metrics
}

{$API_HOST} {
	reverse_proxy api:8000 {
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Access-Control-Allow-Origin *
	}
}

{$SITE_HOST} {
	root * /srv/site
	# The explorer (Project 1.5) is a single-page app under /app/: unknown paths fall back to
	# its index.html so that client-side routes survive a reload.
	@app path /app /app/*
	handle @app {
		try_files {path} /app/index.html
		file_server
	}
	file_server
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
}
